[Unit]
Description=competition simplified 3D viz (/map_clean walls + /viz/scene markers)
After=network-online.target

[Service]
Type=simple
User=ros
Environment="ROS_DOMAIN_ID=0"
Environment="HOME=/home/ros"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && source /home/ros/dev_ws/install/setup.bash && exec python3 /home/ros/viz_scene.py"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target